# Set this only when FME is not available on PATH.
# Windows: C:\Program Files\FME\fme.exe
# Linux/macOS: /opt/fme/fme
FME_EXECUTABLE_PATH=

# Defaults to <project>/fme_scripts when unset.
FME_SCRIPTS_PATH=

# Defaults to <project>/data/jobs.json when unset.
JOBS_FILE_PATH=

# Defaults to <project>/data/running.json when unset.
RUNNING_FILE_PATH=

# Defaults to 3100 when unset.
PORT=3100